# Templat .env untuk stack di VPS. Salin ke /opt/aisha/test/.env dan /opt/aisha/prod/.env,
# lalu isi nilai yang ditandai. Jangan commit berkas hasil salinan.

APP_NAME="Aisha Monitor"
# test: staging · prod: production
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
# test: https://test.domain-anda · prod: https://domain-anda
APP_URL=https://test.domain-anda

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_DATABASE=aisha_monitor
DB_USERNAME=aisha_monitor
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
MAIL_MAILER=log

# Image dari GHCR; nama repository wajib huruf kecil.
APP_IMAGE=ghcr.io/rizalibrah08/sistem-monitoring-produks-app
WEB_IMAGE=ghcr.io/rizalibrah08/sistem-monitoring-produks-web

# test: aisha-test-web · prod: aisha-prod-web (harus sama dengan Caddyfile)
EDGE_ALIAS=aisha-test-web

# test: 128M · prod: 256M
MYSQL_BUFFER_POOL_SIZE=128M

# Midtrans Snap: sandbox untuk fase test, production untuk fase utama.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
